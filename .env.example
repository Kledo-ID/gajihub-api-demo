API_HOST=https://xxx.api.kledo.com/api/v1

# Personal Access Token yang Anda buat di GajiHub (diawali gajihub_pat_)
ACCESS_TOKEN="gajihub_pat_xxxxxx_xxxxxxxxxxxxxxxx"
