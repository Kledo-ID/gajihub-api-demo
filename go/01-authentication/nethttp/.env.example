# Salin file ini menjadi .env, lalu isi. File .env JANGAN di-commit ke Git.

# Alamat API perusahaan Anda, diakhiri /api/v1
GAJIHUB_API_HOST=https://namaperusahaan.api.kledo.com/api/v1

# Personal Access Token dari GajiHub (Pengaturan > API Key), diawali gajihub_pat_
GAJIHUB_ACCESS_TOKEN=gajihub_pat_xxxxxx_xxxxxxxxxxxxxxxx

PORT=3000
